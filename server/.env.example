# Copy this file to .env on the private server, or provide these values through your host's secret manager.
PORT=4173
ADMIN_EMAIL=your-authorized-academy-email@example.com

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
